; NVT equilibration — 300 K, 200 ps, protein position restrained
define          = -DPOSRES
integrator      = md
nsteps          = 100000        ; 200 ps at 2 fs
dt              = 0.002

nstxout         = 500
nstvout         = 500
nstenergy       = 500
nstlog          = 500

cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 10
rcoulomb        = 1.6
rvdw            = 1.6
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.16

tcoupl          = V-rescale
tc-grps         = Protein  Water_and_ions
tau_t           = 0.1      0.1
ref_t           = 300      300

pcoupl          = no

constraints             = h-bonds
constraint_algorithm    = LINCS
lincs_iter              = 1
lincs_order             = 4

gen_vel         = yes
gen_temp        = 300
gen_seed        = -1

pbc             = xyz
