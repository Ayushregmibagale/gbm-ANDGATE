; Energy minimisation — steepest descent
integrator  = steep
emtol       = 1000.0
emstep      = 0.01
nsteps      = 50000

nstlog      = 500
nstenergy   = 500

cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 10
rcoulomb        = 1.0
rvdw            = 1.0
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.16

constraints     = none
pbc             = xyz
